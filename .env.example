# Resend API Key for sending emails
RESEND_API_KEY=your_resend_api_key_here
CONTACT_NOTIFICATION_EMAIL=inquiries@codeviantech.com

# Database Connection (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=codeviantech_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# Admin Panel URL (Production: https://admin.yourdomain.com or https://yourdomain.com/admin)
NEXT_PUBLIC_ADMIN_URL=http://localhost:8000
